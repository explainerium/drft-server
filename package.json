{
  "name": "drft-backend",
  "version": "0.1.0",
  "description": "DRFT API — Express 5 + Prisma + PostgreSQL",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "vercel-build": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:admin": "tsx prisma/seed/admin.seed.ts",
    "seed:catalog": "tsx prisma/seed/catalog.seed.ts",
    "seed:media": "tsx prisma/seed/media.seed.ts",
    "seed:checkout": "tsx prisma/seed/checkout.seed.ts",
    "seed:content": "tsx prisma/seed/content.seed.ts",
    "storage:cors": "tsx scripts/storage-cors.ts",
    "db:backup": "tsx scripts/db-backup.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "nodemailer": "10.1.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "slugify": "1.6.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "sanitize-html": {
      "htmlparser2": "9.1.0"
    }
  }
}
