NODE_ENV=development
PORT=5005
LOG_LEVEL=info

# Pooled connection for the app; DIRECT_URL (session) for prisma migrate.
# Local example: postgresql://postgres:<password>@localhost:5432/drft
DATABASE_URL=
DIRECT_URL=
# DATABASE_POOL_SIZE=5

# Public site origin, used in emails and links.
PUBLIC_BASE_URL=http://localhost:3005
# Comma-separated extra origins. Production is same-origin and needs none.
CORS_ORIGINS=

# Auth. Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL=30d
BCRYPT_ROUNDS=12

# true in production (HTTPS). Same-origin deployment → lax.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Mail. Leave SMTP_HOST empty in development: mails are logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DRFT <no-reply@example.com>

# Storage: local (./storage, served at /media) or r2 (Cloudflare R2).
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Only for `npm run seed:admin`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Payments: a provider is offered at checkout only when its keys are set.
# Without any, development orders stay unpaid; production refuses orders.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Protects GET /api/v1/cron/run (expired reservations, stale carts). At least 16 characters.
CRON_SECRET=
