NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Pooled connection for the app; DIRECT_URL (session) for prisma migrate.
DATABASE_URL=
DIRECT_URL=
# DATABASE_POOL_SIZE=5

# Public site origin, used in emails and links.
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated extra origins. Production is same-origin and needs none.
CORS_ORIGINS=

# Added as their modules land — see PLAN.md §12:
# JWT_*, CREDENTIALS_KEY, COOKIE_*, STORAGE_DRIVER, R2_*, SMTP_*, STRIPE_*, PAYPAL_*, CRON_SECRET
