// Catalog: categories, products, variants and attributes.
//
// English only for now: names and slugs live on the base models.
// If more languages are confirmed, they move to *Translation models.
//
// Money: EUR, stored as Decimal and handled with decimal.js — never JS floats.
// Variant prices are gross (VAT included), as shown to B2C customers.

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id       String     @id @default(uuid())
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  name        String
  slug        String  @unique
  description String?

  imageAssetId String?
  image        Asset?  @relation("CategoryImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  sortOrder Int     @default(0)
  isHidden  Boolean @default(false)

  metaTitle       String?
  metaDescription String?

  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isHidden])
  @@map("categories")
}

model Product {
  id     String        @id @default(uuid())
  name   String
  slug   String        @unique
  status ProductStatus @default(DRAFT)

  // Card label on the image ("Freeride") and the line above the name ("Freeride kite").
  badge     String?
  typeLabel String?

  shortDescription String?
  // Sanitized HTML from the admin rich-text editor.
  description      String?
  // Editorial PDP blocks (highlight, story, features, in-the-box); shape in domain/catalog/productContent.ts.
  content          Json?

  featuredAssetId String?
  featuredAsset   Asset?  @relation("ProductFeatured", fields: [featuredAssetId], references: [id], onDelete: SetNull)

  // "The 2025 Fleet" / featured blocks on the home page.
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  metaTitle       String?
  metaDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categories    ProductCategory[]
  variants      ProductVariant[]
  images        ProductImage[]
  specs         ProductSpec[]
  related       RelatedProduct[]  @relation("RelatedFrom")
  relatedBy     RelatedProduct[]  @relation("RelatedTo")
  wishlistItems WishlistItem[]

  @@index([status])
  @@index([isFeatured, status])
  @@map("products")
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// Every product has at least one variant; a simple product has exactly one
// (isDefault, no attribute values). Price, SKU and stock live here.
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String?  @unique
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  manageStock    Boolean @default(true)
  stock          Int     @default(0)
  allowBackorder Boolean @default(false)

  weightKg Decimal? @db.Decimal(10, 3)

  imageAssetId String?
  image        Asset?  @relation("VariantImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  attributeValues VariantAttributeValue[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
  // Price filtering/sorting on the product list.
  @@index([productId, isActive, price])
  @@map("product_variants")
}

// Variation axes such as Size or Color.
model Attribute {
  id        String @id @default(uuid())
  code      String @unique
  name      String
  sortOrder Int    @default(0)

  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String    @id @default(uuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  code      String
  label     String
  // Swatch colour for colour attributes, e.g. "#1a1c1b".
  hexColor  String?
  sortOrder Int     @default(0)

  variants VariantAttributeValue[]

  @@unique([attributeId, code])
  @@map("attribute_values")
}

model VariantAttributeValue {
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

model ProductImage {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  alt       String?
  sortOrder Int     @default(0)

  @@id([productId, assetId])
  @@index([assetId])
  @@map("product_images")
}

// The technical specifications table on the PDP.
model ProductSpec {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     String?
  label     String
  value     String
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
  @@map("product_specs")
}

// "Complete your setup" on the PDP. Directional: A recommends B.
model RelatedProduct {
  productId String
  product   Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedId String
  related   Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@id([productId, relatedId])
  @@index([relatedId])
  @@map("related_products")
}
