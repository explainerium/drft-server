// VAT per destination country. Prices include VAT, so the rate decides how
// much of the total is VAT, not the total itself. Countries without a row use
// the store's default rate (settings: tax).

model TaxRate {
  // ISO 3166-1 alpha-2, e.g. "NL".
  countryCode String  @id @db.Char(2)
  rate        Decimal @db.Decimal(5, 2)

  updatedAt DateTime @updatedAt

  @@map("tax_rates")
}
