// Orders keep a snapshot of everything they were placed with (names, prices,
// addresses, shipping method), so later catalog or address edits never
// rewrite order history.

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

model Order {
  id     String      @id @default(uuid())
  // Shown to customers as "DRFT-10001".
  number Int         @unique @default(autoincrement())
  status OrderStatus @default(PENDING_PAYMENT)

  // Null for guest orders, or after the account is deleted.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  // The cart it was placed from (no relation: carts are cleaned up). A new
  // checkout from the same cart cancels its earlier unpaid order.
  cartId String?

  // SHA-256 of the token in the buyer's order cookie; lets a guest see their order.
  accessTokenHash String @unique

  email          String
  phone          String?
  marketingOptIn Boolean @default(false)
  // Language of the order mails ("de" | "en"): the store language at checkout.
  locale         String  @default("de")

  // { firstName, lastName, company?, street1, street2?, postcode, city, region?, countryCode, phone? }
  shippingAddress Json
  billingAddress  Json

  shippingMethod String
  currency       String  @default("EUR") @db.Char(3)
  // All amounts gross (VAT included). vatTotal is the VAT inside total.
  subtotal       Decimal @db.Decimal(12, 2)
  shippingTotal  Decimal @db.Decimal(12, 2)
  vatRate        Decimal @db.Decimal(5, 2)
  vatTotal       Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  paymentProvider PaymentProvider?

  // Stock is taken when the order is placed; an unpaid order past this time is
  // cancelled by the cron job and its stock put back.
  reservedUntil DateTime?
  paidAt        DateTime?
  cancelledAt   DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?

  // Set by staff when the order ships; sent to the customer in the shipping mail.
  trackingCarrier String?
  trackingNumber  String?
  trackingUrl     String?

  items   OrderItem[]
  history OrderStatusHistory[]
  notes   OrderNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([cartId])
  @@index([status, reservedUntil])
  @@index([status, createdAt])
  @@index([paidAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Kept while the variant exists; the snapshot below is what the order shows.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId String?

  productName String
  productSlug String
  typeLabel   String?
  sku         String?
  // [{ name: "Kite Size", value: "9m²" }, ...]
  options     Json
  imageUrl    String?

  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(12, 2)

  // The cart's line order.
  position Int @default(0)

  // True when this line took tracked stock, so cancelling puts it back.
  stockTaken Boolean @default(false)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id      String      @id @default(uuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  OrderStatus
  note    String?
  // The staff member who changed it; null for the customer, payments and the cron job.
  actorId String?
  actor   User?       @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// Internal notes on an order, for staff only (never shown to the customer).
model OrderNote {
  id       String  @id @default(uuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation("OrderNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body     String

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_notes")
}
