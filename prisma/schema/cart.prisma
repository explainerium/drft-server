// A guest cart is found by the random token in its cookie; a signed-in
// customer's cart by userId. The guest cart is merged into the customer's on
// their next request after signing in.
model Cart {
  id     String  @id @default(uuid())
  token  String? @unique
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stale guest carts are cleaned up by age.
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}
